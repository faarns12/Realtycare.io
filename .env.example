# Copy this file to .env.local and fill in the values.

# 1) Google Sheets: paste the Web App URL from your Apps Script deployment
#    (see google-apps-script/README.md). Every form on the site saves a row there.
GOOGLE_SHEET_WEBHOOK_URL=

# 2) A shared secret. Put the SAME value in the Apps Script (SHARED_SECRET).
#    It stops strangers from writing rows into your sheet.
GOOGLE_SHEET_SECRET=change-me-to-a-long-random-string

# 3) Optional: the "Get called by the AI" demo on the home page can trigger a real Vapi call.
#    Leave blank to only save the request to the sheet.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# 4) Your public site address (used for SEO tags and the sitemap)
NEXT_PUBLIC_SITE_URL=https://realtycare.io

# 5) Supabase: every form submission is saved in the `leads` table and shown at /admin.
#    Supabase → Project Settings → API Keys. Run supabase/schema.sql once in the SQL Editor first.
#    The publishable key is safe to use here; row level security only lets the public ADD leads.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
#    Admin login: create the user in Supabase → Authentication → Users → Add user (tick "Auto confirm"),
#    and make sure the email is in the public.admin_emails table (schema.sql adds info@realtycare.io).
